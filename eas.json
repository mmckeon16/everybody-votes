{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_SUPABASE_URL": "https://everybody-polls-api.onrender.com",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "everybody-polls-public"
      },
      "channel": "development",
      "environment": "development",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "node": "22.22.0"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_SUPABASE_URL": "https://everybody-polls-api.onrender.com",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "everybody-polls-public"
      },
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "node": "22.22.0"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_SUPABASE_URL": "https://everybody-polls-api.onrender.com",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "everybody-polls-public"
      },
      "channel": "production",
      "environment": "production",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "node": "22.22.0"
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
