{
  "name": "everybody-votes",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "build:remote:ios": "eas build --platform ios",
    "submit:remote:ios": "eas submit --platform ios",
    "build:local:android": "npx dotenv -- eas build --platform android --profile production --local --output builds/android/app-$(date +%Y%m%d_%H%M%S).aab",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "format": "prettier --write .",
    "clean": "rm -rf .expo node_modules",
    "postinstall": "npx tailwindcss -i ./global.css -o ./node_modules/.cache/nativewind/global.css",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo"
  },
